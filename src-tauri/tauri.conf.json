{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MVO Hub",
  "version": "0.2.13",
  "identifier": "com.projectmvo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MVO Hub",
        "width": 1500,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "center": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' http://localhost:* https:; media-src 'self' https:; frame-src 'self' https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Project MVO",
    "homepage": "https://github.com/Adude4554/MVO-Hub",
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "languages": ["English"]
      },
      "wix": {}
    }
  },
  "plugins": {}
}
