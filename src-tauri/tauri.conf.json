{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MVO Beta",
  "version": "0.1.1",
  "identifier": "com.projectmvo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MVO Hub",
        "width": 1500,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "center": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxMDkyQTg0RTdFQUU2QzUKUldURjV1cm5oQ29KY1NZWHU0OGlOQWF6M1l6Mytqd1hIa1RsaDdyTHpTWnBqMUJSdEs5aWE3NTAK",
      "endpoints": [
        "https://github.com/adude4554/MVO-Hub/releases/latest/download/latest.json"
      ],
      "dialog": true
    }
  }
}